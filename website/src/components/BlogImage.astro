---
import type { ImageMetadata } from 'astro';

type Props = {
	src: ImageMetadata;
	alt: string;
	caption?: string;
	captionHref?: string;
};

const { src, alt, caption, captionHref } = Astro.props;
---

<figure class="blog-image">
	<img
		src={src.src}
		alt={alt}
		loading="lazy"
		decoding="async"
		width={src.width}
		height={src.height}
	/>
	{
		caption && (
			<figcaption>
				{captionHref ? <a href={captionHref}>{caption}</a> : caption}
			</figcaption>
		)
	}
</figure>

<style>
	.blog-image {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 100%;
		margin: 2em auto;
	}

	.blog-image :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
	}

	.blog-image figcaption {
		margin-top: 0.5em;
		opacity: 0.65;
		font-size: 0.9em;
		font-style: italic;
		line-height: 1.4;
		text-align: center;
	}
</style>
